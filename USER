const handleAcceptCall = async () => {
  // 1. MOBILE OPTIMIZATION: Unlock Audio Context immediately on user gesture
  const AudioContext = window.AudioContext || window.webkitAudioContext;
  const audioCtx = new AudioContext();
  if (audioCtx.state === 'suspended') audioCtx.resume();

  // 2. Stop ringtone immediately
  if (ringtoneAudio.current) {
    ringtoneAudio.current.pause();
    ringtoneAudio.current.src = "";
    ringtoneAudio.current.currentTime = 0;
  }

  const token = localStorage.getItem('userToken');
  const callId = activeCall?.callId || activeCall?._id;
  const activeVoice = activeCall?.voiceId || "nPczCjzB2QC9zZ6ULpFM"; 

  try {
    console.log("🔗 Fast Handshake: Accepting call for Voice:", activeVoice);
    setCallStatus('connecting');
    setShowFullScreenCall(true);

    // 3. Prioritize signal from props to avoid unnecessary DB fetch latency
    let incomingSignal = activeCall?.signal;
    if (!incomingSignal) {
      const res = await fetch(`/api/calls/status/${callId}`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const data = await res.json();
      incomingSignal = data.signal || data.answerSignal;
    }

    if (!incomingSignal) throw new Error("Handshake signal missing.");

    // 4. Capture User Audio early
    const stream = await navigator.mediaDevices.getUserMedia({ 
      audio: { 
        echoCancellation: true, 
        noiseSuppression: true, 
        autoGainControl: true 
      }
    });
    userStreamRef.current = stream;

    const PeerConstructor = Peer.default || Peer;
    const peer = new PeerConstructor({
      initiator: false, 
      trickle: true, // 🔥 CRITICAL: Enable Trickle ICE for faster mobile connections
      stream: stream,
      config: { 
        iceServers: [
          { urls: 'stun:stun.l.google.com:19302' },
          { urls: 'stun:stun1.l.google.com:19302' }
        ] 
      }
    });
    peer.on('signal', async (data) => {
      const targetId = activeCall?.fromId || activeCall?.callerData?.callerId;
      if (targetId) {
        socket.emit("answer-call", { 
          to: targetId.toString(), 
