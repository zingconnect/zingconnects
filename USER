const handleEndCall = useCallback(() => {
  console.log("📴 Initiating Shutdown Sequence...");
  
  // 1. Clear timeouts
  if (connectionTimeoutRef.current) {
    clearTimeout(connectionTimeoutRef.current);
    connectionTimeoutRef.current = null;
  }

  // 2. Identify the peer to notify
  const myId = userData?._id || userData?.id;
  const targetId = activeCall?.fromId === myId
    ? activeCall?.receiverId 
    : activeCall?.fromId;

  const currentCallId = activeCall?.callId || activeCall?._id;

  // 3. Notify Socket and stop audio listeners
  if (socket && targetId) {
    console.log(`📡 Sending termination signal to peer: ${targetId}`);
    socket.emit("end-call", { to: targetId, callId: currentCallId });
    socket.off("ai-audio-chunk");
  }

  // 4. WebRTC Cleanup
  if (connectionRef.current) {
    console.log("🧹 Executing Local Hardware Cleanup...");
    connectionRef.current.removeAllListeners();
    try {
      connectionRef.current.destroy();
    } catch (e) {
      console.warn("Peer already destroyed");
    }
    connectionRef.current = null;
  }

  // 5. Media Stream Cleanup
  const streams = [userStreamRef?.current, localStream];
  streams.forEach(stream => {
    if (stream && typeof stream.getTracks === 'function') {
      stream.getTracks().forEach(track => {
        track.stop();
        console.log(`✅ ${track.kind} hardware released.`);
      });
    }
  });

  if (userStreamRef) userStreamRef.current = null;
  setLocalStream(null);

  // 6. Audio Element Cleanup
  const remoteAudio = document.getElementById('remoteAudio');
  if (remoteAudio) {
    remoteAudio.pause();
    remoteAudio.srcObject = null;
    remoteAudio.src = "";
    remoteAudio.load();
  }

  // 7. Reset UI State
  setCallStatus('idle');
  setPeerConnected(false);
  setShowFullScreenCall(false);
  setActiveCall(null);
  setActiveCaller(null);
  setCallTime(0);

  console.log("✅ Hardware and UI reset complete. System Idle.");
}, [socket, userData?._id, userData?.id, activeCall, localStream]);

