const handleStartCall = async () => {
  // 1. Buffer Polyfill
  if (typeof window !== 'undefined' && !window.Buffer) {
    const { Buffer } = await import('buffer');
    window.Buffer = Buffer;
  }

  const currentUserId = userData?._id || userData?.id;
  const currentAgentId = agent?._id || agent?.id;
  const token = localStorage.getItem('userToken');

  if (!currentAgentId || !currentUserId) {
    alert("Profile data still loading. Please try again.");
    return;
  }

  setCallStatus('calling'); 
  setShowFullScreenCall(true);

  try {
    // 2. Capture Local Media
    const stream = await navigator.mediaDevices.getUserMedia({ 
      audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true }, 
      video: false 
    });

    userStreamRef.current = stream;
    setLocalStream(stream);

    // 3. Initialize Peer
    const { default: SimplePeer } = await import('simple-peer');
    const peer = new SimplePeer({
      initiator: true,
      trickle: false,
      stream: stream,
      config: { iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] }
    });

    connectionRef.current = peer;

    // 4. Offer Generation
    peer.on('signal', async (signalData) => {
      console.log("📤 WebRTC Offer generated.");
      
      const API_BASE_URL = window.location.origin.includes('localhost') 
        ? "http://localhost:5000" 
        : "https://zingconnect.vercel.app";

      try {
        const res = await fetch('/api/calls/start', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify({ 
            receiverId: currentAgentId, 
            receiverModel: 'Agent',
            signal: signalData 
          })
        });

        const data = await res.json();
        if (!data.success) throw new Error(data.message || "Agent unavailable");

        const photoPath = userData?.photoUrl;
        const fullPhotoUrl = photoPath?.startsWith('http') 
          ? photoPath 
          : `${API_BASE_URL}/${photoPath?.replace(/^\//, '') || 'default-avatar.png'}`;

        setActiveCall({ 
          callId: data.callId,
          toId: currentAgentId.toString(), // Use toId for consistency in handleEndCall
          fromId: currentUserId,
          isInitiator: true,
          signal: signalData,
          callerData: {
            fromName: `${userData?.firstName} ${userData?.lastName}`,
            photoUrl: fullPhotoUrl,
            callerId: currentUserId
          }
        });

        socket.emit("call-user", {
          userToCall: currentAgentId.toString(),
          fromId: currentUserId,
          fromName: `${userData?.firstName} ${userData?.lastName}`,
          photoUrl: fullPhotoUrl,
          callId: data.callId,
          signal: signalData 
        });

        // Move to ringing once backend confirms receipt
        setCallStatus('ringing'); 
      } catch (apiErr) {
        console.error("❌ Failed to initiate call:", apiErr);
        handleEndCall();
      }
    });

    // 5. Handle Acceptance
    socket.off("call-accepted").on("call-accepted", (acceptData) => {
      console.log("📡 Agent accepted.");
      const remoteAnswer = acceptData.signal || acceptData.answerSignal;

      if (remoteAnswer && connectionRef.current) {
        try {
          const parsedSignal = typeof remoteAnswer === 'string' 
            ? JSON.parse(remoteAnswer) 
            : remoteAnswer;
          
          connectionRef.current.signal(parsedSignal);
          setCallStatus('connecting'); 
        } catch (err) {
          console.error("❌ Handshake failed:", err);
        }
      }
    });

    // 6. Connected Stream
    peer.on('stream', (remoteStream) => {
      console.log("🔈 Connection established.");
      
      // ✅ Use the Ref to clear the timeout
      if (connectionTimeoutRef.current) {
        clearTimeout(connectionTimeoutRef.current);
        connectionTimeoutRef.current = null;
      }
      
      let audio = document.getElementById('remoteAudio');
      if (!audio) {
        audio = document.createElement('audio');
        audio.id = 'remoteAudio';
        audio.autoplay = true;
        document.body.appendChild(audio);
      }
      
      audio.srcObject = remoteStream;
      audio.muted = true; // Muted because we use AI audio chunks
      
      setCallStatus('connected');
      setPeerConnected(true);
    });
    connectionTimeoutRef.current = setTimeout(() => {
      if (connectionRef.current && !connectionRef.current.connected) {
        console.warn("⏳ Call timed out: No answer from agent.");
        handleEndCall();
        alert("Agent did not answer. Connection timed out.");
      }
    }, 35000); 

    peer.on('error', (err) => {
      console.error("❌ Peer Error:", err);
      handleEndCall();
    });

  } catch (err) {
    console.error("❌ Call initialization failed:", err);
    if (connectionTimeoutRef.current) clearTimeout(connectionTimeoutRef.current);
    handleEndCall();
  }
};

